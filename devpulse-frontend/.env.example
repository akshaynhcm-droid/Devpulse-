# DevPulse Frontend Environment Variables

# Python backend (FastAPI) — agent, security, analytics, auth, admin
NEXT_PUBLIC_API_URL=http://localhost:8000

# TypeScript backend (tRPC) — OAuth, main app API
NEXT_PUBLIC_TS_API_URL=http://localhost:3000

# WebSocket (Python backend)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# App URL (for OAuth redirects on landing/login/register pages)
NEXT_PUBLIC_APP_URL=http://localhost:3000
