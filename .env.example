# ============================================
# DevPulse Environment Configuration
# Copy this file to .env and fill in values
# ============================================

# ──────────────────────────────────────────────
# DATABASE (MySQL / PlanetScale / Neon compatible)
# ──────────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/devpulse_db

# ──────────────────────────────────────────────
# AUTHENTICATION (Manus OAuth)
# ──────────────────────────────────────────────
# Application ID registered in Manus developer portal
VITE_APP_ID=your_manus_app_id

# JWT signing secret — MUST be at least 32 characters!
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_ME_with_a_long_random_secret_at_least_32_chars

# OAuth server base URL (leave default for Manus cloud)
OAUTH_SERVER_URL=https://auth.manus.app

# OpenID of the account that should have admin role
OWNER_OPEN_ID=your_open_id_here

# ──────────────────────────────────────────────
# GOOGLE OAUTH 2.0 (for "Sign in with Google")
# ──────────────────────────────────────────────
# Get credentials at: https://console.cloud.google.com/apis/credentials
# 1. Create a new OAuth 2.0 Client ID (Web application)
# 2. Add Authorized redirect URI: https://yourapp.devpulse.app/api/oauth/google/callback
# 3. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ──────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Public-facing URL for email links (no trailing slash)
APP_URL=https://yourapp.devpulse.app

# ──────────────────────────────────────────────
# MINIMAX M2.7 (Primary LLM Brain)
# ──────────────────────────────────────────────
# Get your API key at: https://platform.minimax.io
# MiniMax M2.7 is a powerful reasoning model (OpenAI-compatible API)
# When set, this takes priority over the Forge/Manus API below.
MINIMAX_API_KEY=your_minimax_api_key
# International endpoint (default). For China mainland use: https://api.minimaxi.com/v1
MINIMAX_API_URL=https://api.minimax.io/v1

# ──────────────────────────────────────────────
# BUILT-IN FORGE API (LLM / AI — fallback)
# ──────────────────────────────────────────────
BUILT_IN_FORGE_API_URL=https://api.manus.app/forge
BUILT_IN_FORGE_API_KEY=your_forge_api_key

# ──────────────────────────────────────────────
# EMAIL (SMTP — required for team invite emails)
# ──────────────────────────────────────────────
# Recommended: Resend (resend.com), SendGrid, or AWS SES
# Leave blank to skip email delivery (invites stored but not sent)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_smtp_api_key
SMTP_FROM=DevPulse <noreply@yourapp.devpulse.app>

# ──────────────────────────────────────────────
# NOTIFICATIONS
# ──────────────────────────────────────────────
# Slack webhook for kill switch alerts (leave blank to disable)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ──────────────────────────────────────────────
# GITHUB INTEGRATION (optional — webhook features disabled without these)
# ──────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# ──────────────────────────────────────────────
# REDIS CACHE (optional — improves performance)
# ──────────────────────────────────────────────
# Redis URL for caching dashboard stats, collections, compliance scores
# Leave blank to disable caching (uses in-memory fallback)
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────
# ERROR MONITORING (optional)
# ──────────────────────────────────────────────
# Sentry DSN for error tracking (leave blank to disable)
SENTRY_DSN=https://example@o0.ingest.sentry.io/0

# Frontend Sentry DSN (can be same as backend or separate project)
NEXT_PUBLIC_SENTRY_DSN=https://example@o0.ingest.sentry.io/0
NEXT_PUBLIC_ENVIRONMENT=production

# ──────────────────────────────────────────────
# AWS S3 (for file storage / database backups)
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=devpulse-exports

# ──────────────────────────────────────────────
# DATABASE BACKUP CONFIGURATION
# ──────────────────────────────────────────────
# S3 bucket for automated database backups
S3_BACKUP_BUCKET=devpulse-backups
# Retention: daily backups kept for 30 days, monthly for 12 months
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_MONTHS=12

# ──────────────────────────────────────────────
# RAZORPAY PAYMENTS (required for Pro/Enterprise plans)
# ──────────────────────────────────────────────
# Get credentials at: https://dashboard.razorpay.com
# 1. Create a Razorpay account
# 2. Generate API Keys from Settings > API Keys
# 3. Set up webhook endpoint: https://yourapp.devpulse.app/api/webhooks/razorpay
#    Events: payment.captured, payment.failed, subscription.cancelled
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Frontend URL for payment callbacks
FRONTEND_URL=https://yourapp.devpulse.app

# ──────────────────────────────────────────────
# GITHUB WEBHOOK (optional, for CI/CD integration)
# ──────────────────────────────────────────────
# Get webhook secret from: https://github.com/YOUR_ORG/YOUR_REPO/settings/hooks
# Events: push, pull_request
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret