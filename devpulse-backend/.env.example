# DevPulse Python Backend Environment Variables
# REQUIRED — app will not start without these
SECRET_KEY=your-secret-key-here-min-32-chars

# Database (defaults to SQLite for local dev)
DATABASE_URL=sqlite:///./devpulse.db

# Razorpay (optional — payment features disabled without these)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# GitHub Integration (optional — webhook features disabled without these)
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Slack Integration (optional — alert features disabled without these)
SLACK_WEBHOOK_URL=

# Frontend URL for CORS and redirects
FRONTEND_URL=http://localhost:3000
